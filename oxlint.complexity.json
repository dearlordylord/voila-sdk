{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "**/coverage",
    "**/dist",
    "**/node_modules",
    "**/test",
    "**/test/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "rules": {
    "complexity": [
      "error",
      {
        "max": 8,
        "variant": "classic"
      }
    ]
  }
}
