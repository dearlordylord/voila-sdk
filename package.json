{
  "name": "voila-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Private workspace for Voila SDK, MCP server, and CLI packages",
  "type": "module",
  "scripts": {
    "prepare": "husky && node scripts/prepare-effect-tsgo.mjs",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm typecheck:tsc && pnpm typecheck:effect",
    "typecheck:tsc": "pnpm -r --filter './packages/*' typecheck && tsc -p tsconfig.lint.json --noEmit",
    "typecheck:effect": "effect-tsgo diagnostics --project tsconfig.lint.json --strict --severity error,warning",
    "test": "vitest run",
    "test:harness": "vitest run scripts/*.test.ts --coverage.enabled=false",
    "test:coverage": "vitest run packages --reporter=dot --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary && node scripts/verify-coverage-summary.mjs",
    "test:watch": "vitest",
    "rebuild:native": "CI=true pnpm install --frozen-lockfile --prefer-offline && pnpm rebuild esbuild unrs-resolver @parcel/watcher rolldown",
    "smoke:catalog-search": "pnpm --filter @firfi/voila-sdk smoke:catalog-search",
    "smoke:cart": "pnpm --filter @firfi/voila-sdk smoke:cart",
    "smoke:request-identity": "pnpm --filter @firfi/voila-mcp smoke:request-identity",
    "smoke:auth-readonly": "pnpm --filter @firfi/voila-sdk smoke:auth-readonly",
    "auth:capture": "pnpm --filter @firfi/voila-sdk auth:capture",
    "drift:audit": "pnpm --filter @firfi/voila-sdk drift:audit",
    "fixtures:audit": "node scripts/audit-fixtures.mjs packages/voila-sdk/test/fixtures",
    "validate-registry-schema": "node scripts/validate-registry-schema.mjs",
    "lint": "oxlint --deny-warnings --tsconfig=tsconfig.lint.json packages scripts vitest.config.ts && eslint -c eslint.policy.config.mjs packages && dprint check && jscpd --silent packages/*/src",
    "lint:fix": "oxlint --fix --deny-warnings --tsconfig=tsconfig.lint.json packages scripts vitest.config.ts && eslint -c eslint.policy.config.mjs packages --fix && dprint fmt",
    "format": "dprint fmt",
    "check-format": "dprint check",
    "circular": "dpdm --no-warning --no-tree --no-progress --exit-code circular:1 --transform 'packages/*/src/**/*.ts'",
    "check:complexity": "node scripts/check-oxlint-complexity.mjs",
    "check:complexity:prune": "node scripts/check-oxlint-complexity.mjs --prune",
    "check:package-boundary": "node scripts/check-package-boundaries.mjs",
    "package:audit": "pnpm -r --filter './packages/*' package:audit",
    "sync-registry-metadata": "node scripts/sync-registry-metadata.mjs",
    "verify-registry-metadata": "node scripts/sync-registry-metadata.mjs --check",
    "release:check": "pnpm check-all && pnpm validate-registry-schema && pnpm package:audit",
    "release:local": "pnpm release:check && pnpm -r --filter './packages/*' publish --dry-run",
    "release:publish": "pnpm rebuild:native && pnpm release:check && node scripts/publish-registry-tag.mjs --check && node scripts/publish-if-needed.mjs && node scripts/publish-registry-tag.mjs",
    "check-all": "node scripts/run-quality-gate.mjs"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@effect/language-service": "^0.73.1",
    "@effect/tsgo": "^0.24.3",
    "@effect/vitest": "latest",
    "@types/node": "^25.1.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "latest",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dpdm": "4.2.0",
    "dprint": "^0.55.2",
    "effect": "^3.19.15",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "^9.0.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "lint-staged": "^16.2.7",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "latest"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "oxlint --fix --deny-warnings",
      "eslint -c eslint.policy.config.mjs",
      "dprint fmt --allow-no-files"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "dprint",
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
